# Firebase web app configuration (public values; used by the browser build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=stbpplay-platform
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK values for Netlify Functions (server only)
FIREBASE_PROJECT_ID=stbpplay-platform
FIREBASE_SERVICE_ACCOUNT_JSON=
STB_KEY_MASTER_SECRET=

# Payment and delivery are intentionally inactive until configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
