{
  "name": "stbplay-platform",
  "private": true,
  "scripts": {
    "deploy": "firebase deploy --only firestore:rules,firestore:indexes,functions",
    "emulators": "firebase emulators:start --only functions,firestore,auth",
    "test:emulator": "firebase emulators:exec --project demo-stbpplatform --only auth,firestore,functions \"node functions/tests/partner-emulator.test.cjs\""
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  },
  "overrides": {
    "pg-protocol": "1.16.0"
  }
}
